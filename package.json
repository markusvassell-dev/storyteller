{
  "name": "storytime-library",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A private, single-owner children's picture-book library PWA for iPhone and iPad.",
  "scripts": {
    "dev": "vite",
    "build": "npm run audit:rights && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:rights": "tsx scripts/rights-audit.ts",
    "audit:assets": "tsx scripts/asset-optimizer.ts --check",
    "audit:links": "tsx scripts/link-check.ts",
    "narration:map": "tsx scripts/narration-helper.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run audit:rights && npm run audit:assets",
    "books:fetch": "tsx scripts/books/fetch-books.ts",
    "books:probe": "tsx scripts/books/probe.ts"
  },
  "dependencies": {
    "@fontsource-variable/baloo-2": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
